---
import Avatar from './Avatar.astro';
import { links } from '../data/links';
---

<aside class="w-full shrink-0 lg:sticky lg:top-12 lg:w-[260px] lg:self-start">
  <Avatar initials="JT" name={links.name} size={88} />

  <h1 class="mt-5 text-xl font-bold leading-tight text-ink">{links.name}</h1>
  <p class="mt-3 text-sm leading-relaxed text-muted">
    NTU CS senior heading into an MSCS, researching HPC systems and LLM inference.
  </p>

  <dl class="mt-6 space-y-3 border-t border-border pt-6 text-xs">
    <div class="flex items-center justify-between gap-4">
      <dt class="font-semibold uppercase tracking-wide text-muted">Focus</dt>
      <dd class="font-mono text-ink">HPC / ML Systems</dd>
    </div>
    <div class="flex items-center justify-between gap-4">
      <dt class="font-semibold uppercase tracking-wide text-muted">Degree</dt>
      <dd class="font-mono text-ink">B.S. CS</dd>
    </div>
    <div class="flex items-center justify-between gap-4">
      <dt class="font-semibold uppercase tracking-wide text-muted">Grad</dt>
      <dd class="font-mono text-ink">2026</dd>
    </div>
  </dl>

  <div class="mt-6 flex items-center gap-3 border-t border-border pt-6">
    <a
      href={`mailto:${links.email}`}
      aria-label="Email"
      class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-muted transition-colors hover:border-accent hover:text-accent"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0-.83.67-1.5 1.5-1.5h16.5c.83 0 1.5.67 1.5 1.5v10.5c0 .83-.67 1.5-1.5 1.5H3.75a1.5 1.5 0 0 1-1.5-1.5V6.75Z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="m3 7 9 6 9-6" />
      </svg>
    </a>
    <a
      href={links.github}
      target="_blank"
      rel="noreferrer"
      aria-label="GitHub"
      class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-muted transition-colors hover:border-accent hover:text-accent"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.48 2 2 6.58 2 12.2c0 4.49 2.87 8.3 6.84 9.64.5.1.68-.22.68-.49 0-.24-.01-1.04-.01-1.88-2.78.61-3.37-1.21-3.37-1.21-.46-1.19-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.9 1.55 2.36 1.11 2.94.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.32 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.2C22 6.58 17.52 2 12 2Z" />
      </svg>
    </a>
    <a
      href={links.linkedin}
      target="_blank"
      rel="noreferrer"
      aria-label="LinkedIn"
      class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-muted transition-colors hover:border-accent hover:text-accent"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
        <path d="M6.94 5a1.94 1.94 0 1 1-3.88 0 1.94 1.94 0 0 1 3.88 0ZM3.25 8.75h3.62V21H3.25V8.75Zm6.13 0h3.47v1.68h.05c.48-.9 1.66-1.86 3.42-1.86 3.66 0 4.34 2.4 4.34 5.52V21h-3.62v-5.32c0-1.27-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.81V21H9.38V8.75Z" />
      </svg>
    </a>
  </div>

  <a
    href={links.cv}
    download
    class="mt-6 block rounded-md border border-ink px-4 py-2.5 text-center text-sm font-semibold text-ink transition-colors hover:bg-ink hover:text-bg"
  >
    Download CV
  </a>
</aside>
