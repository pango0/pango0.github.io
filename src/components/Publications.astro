---
import SectionHeading from './SectionHeading.astro';
import { publications } from '../data/publications';

const namePattern = /(Jui-Chien Tsou|J\.-C\. Tsou)/;
function splitAuthors(authors: string) {
  return authors.split(namePattern).map((segment) => ({
    text: segment,
    highlight: segment === 'Jui-Chien Tsou' || segment === 'J.-C. Tsou',
  }));
}
---

<section id="publications">
  <SectionHeading title="Publications" />
  <div>
    {publications.map((pub, index) => (
      <article
        data-animate
        style={`--reveal-delay: ${Math.min(index * 0.1, 0.3)}s`}
        class="flex flex-wrap gap-x-6 gap-y-4 border-b border-border py-6 first:pt-0"
      >
        {pub.image && (
          pub.link ? (
            <a
              href={pub.link}
              target="_blank"
              rel="noreferrer"
              aria-label={`Read “${pub.title}” on arXiv`}
              class="group block h-[118px] w-[180px] shrink-0 overflow-hidden rounded-lg border border-border bg-white p-1.5"
            >
              <img
                src={pub.image}
                alt={pub.imageAlt ?? `Figure from “${pub.title}”`}
                loading="lazy"
                class="h-full w-full object-contain transition-transform duration-300 ease-out group-hover:scale-[1.04]"
              />
            </a>
          ) : (
            <span class="group block h-[118px] w-[180px] shrink-0 overflow-hidden rounded-lg border border-border bg-white p-1.5">
              <img
                src={pub.image}
                alt={pub.imageAlt ?? `Figure from “${pub.title}”`}
                loading="lazy"
                class="h-full w-full object-contain transition-transform duration-300 ease-out group-hover:scale-[1.04]"
              />
            </span>
          )
        )}
        <div class="min-w-0 flex-[1_1_380px]">
          <h3 class="text-[15px] font-bold leading-snug text-ink">
            {pub.link ? (
              <a
                href={pub.link}
                target="_blank"
                rel="noreferrer"
                class="transition-colors hover:text-accent"
              >
                {pub.title}
              </a>
            ) : (
              pub.title
            )}
          </h3>
          <p class="mt-2 text-xs leading-relaxed text-muted">
            {splitAuthors(pub.authors).map((segment) =>
              segment.highlight ? (
                <strong class="font-semibold text-ink">{segment.text}</strong>
              ) : (
                segment.text
              )
            )}
          </p>
          <p class="mt-1 font-mono text-[11px] text-muted">{pub.venue} · {pub.year}</p>
          <p class="mt-2.5 text-[13.5px] leading-relaxed text-body">{pub.description}</p>
          {(pub.note || pub.link) && (
            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
              {pub.note && (
                <span class="rounded-full border border-accent px-2.5 py-0.5 font-mono text-[11px] font-semibold text-accent">
                  {pub.note}
                </span>
              )}
              {pub.link && (
                <a
                  href={pub.link}
                  target="_blank"
                  rel="noreferrer"
                  class="font-mono text-xs text-accent transition-colors hover:text-accent-hover"
                >
                  arXiv <span aria-hidden="true">&#8599;</span>
                </a>
              )}
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</section>
