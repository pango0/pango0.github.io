---
import SectionHeading from './SectionHeading.astro';
import { publications } from '../data/publications';
---

<section id="publications" data-animate>
  <SectionHeading title="Publications" />
  <div class="space-y-5">
    {publications.map((pub) => (
      <article class="rounded-lg border border-border bg-surface p-5">
        <div class="flex flex-wrap items-start justify-between gap-2">
          <h3 class="text-sm font-bold leading-snug text-ink">{pub.title}</h3>
          {pub.note && (
            <span class="shrink-0 rounded-full border border-accent/30 bg-accent/5 px-2.5 py-1 font-mono text-xs font-semibold text-accent">
              {pub.note}
            </span>
          )}
        </div>
        <p class="mt-2 text-xs leading-relaxed text-muted">{pub.authors}</p>
        <p class="mt-1 font-mono text-[11px] text-muted">{pub.venue}, {pub.year}</p>
        <p class="mt-3 text-sm leading-relaxed text-muted">{pub.description}</p>
      </article>
    ))}
  </div>
</section>
