---
import SectionHeading from './SectionHeading.astro';
import { publications } from '../data/publications';
---

<section id="publications">
  <SectionHeading title="Publications" />
  <div class="space-y-5">
    {publications.map((pub, index) => (
      <article
        data-animate
        tabindex="0"
        style={`--reveal-delay: ${Math.min(index * 0.1, 0.3)}s`}
        class="group rounded-lg border border-border bg-surface p-5 outline-none transition-all duration-200 ease-out hover:-translate-y-1 hover:border-accent/40 hover:shadow-lg hover:shadow-accent/5 focus-visible:-translate-y-1 focus-visible:border-accent/40 focus-visible:shadow-lg focus-visible:shadow-accent/5"
      >
        <div class="flex flex-wrap items-start justify-between gap-2">
          <h3 class="text-sm font-bold leading-snug text-ink">
            {pub.link ? (
              <a
                href={pub.link}
                target="_blank"
                rel="noreferrer"
                class="transition-colors hover:text-accent"
              >
                {pub.title}
              </a>
            ) : (
              pub.title
            )}
          </h3>
          {pub.note && (
            <span class="shrink-0 rounded-full border border-accent/30 bg-accent/5 px-2.5 py-1 font-mono text-xs font-semibold text-accent">
              {pub.note}
            </span>
          )}
        </div>
        <p class="mt-2 text-xs leading-relaxed text-muted">{pub.authors}</p>
        <p class="mt-1 font-mono text-[11px] text-muted">{pub.venue}, {pub.year}</p>
        <p class="mt-3 text-sm leading-relaxed text-muted">{pub.description}</p>
        {pub.image && (
          <div class="mt-0 max-h-0 overflow-hidden opacity-0 transition-all duration-300 ease-out group-hover:mt-4 group-hover:max-h-[32rem] group-hover:opacity-100 group-focus-within:mt-4 group-focus-within:max-h-[32rem] group-focus-within:opacity-100">
            {pub.link ? (
              <a
                href={pub.link}
                target="_blank"
                rel="noreferrer"
                aria-label={`Read “${pub.title}” on arXiv`}
                class="block"
              >
                <img
                  src={pub.image}
                  alt={pub.imageAlt ?? `Figure from “${pub.title}”`}
                  loading="lazy"
                  class="w-full rounded-md border border-border bg-white p-2"
                />
              </a>
            ) : (
              <img
                src={pub.image}
                alt={pub.imageAlt ?? `Figure from “${pub.title}”`}
                loading="lazy"
                class="w-full rounded-md border border-border bg-white p-2"
              />
            )}
          </div>
        )}
      </article>
    ))}
  </div>
</section>
