---
import SectionHeading from './SectionHeading.astro';
import { education } from '../data/education';
---

<section id="education" data-animate>
  <SectionHeading title="Education" />
  <article class="rounded-lg border border-border bg-surface p-5 transition-all duration-200 ease-out hover:-translate-y-1 hover:border-accent/40 hover:shadow-lg hover:shadow-accent/5">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h3 class="text-sm font-bold text-ink">{education.school}</h3>
      <span class="font-mono text-[11px] text-muted">{education.period}</span>
    </div>
    <p class="mt-1 text-xs text-muted">{education.degree}</p>
    <p class="mt-0.5 text-xs text-muted">{education.location}</p>
    <div class="mt-3 flex flex-wrap gap-2">
      {education.details.map((d) => (
        <span class="inline-flex items-center rounded-full border border-border bg-bg px-3 py-1 font-mono text-xs text-ink">
          {d}
        </span>
      ))}
    </div>
  </article>
</section>
