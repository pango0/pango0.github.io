---
import SectionHeading from './SectionHeading.astro';
import { education } from '../data/education';
---

<section id="education">
  <SectionHeading title="Education" />
  <div data-animate>
    <div class="flex flex-wrap items-baseline justify-between gap-x-5 gap-y-1">
      <h3 class="text-[15px] font-bold text-ink">{education.school}</h3>
      <span class="font-mono text-[11px] text-muted">{education.period}</span>
    </div>
    <p class="mt-1.5 text-[13px] text-muted">{education.degree} · {education.location}</p>
    <div class="mt-3.5 flex flex-wrap gap-2">
      {education.details.map((d) => (
        <span class="inline-flex items-center rounded-full border border-border bg-surface px-3 py-1 font-mono text-xs text-ink">
          {d}
        </span>
      ))}
    </div>
  </div>
</section>
