---
interface Props {
  initials: string;
  name: string;
  src?: string;
  size?: number;
}

const { initials, name, src, size = 96 } = Astro.props;
---

{src ? (
  <img
    src={src}
    alt={name}
    width={size}
    height={size}
    class="rounded-full object-cover transition-transform duration-300 hover:scale-[1.03]"
    style={`width:${size}px;height:${size}px;`}
  />
) : (
  <div
    class="flex items-center justify-center rounded-full bg-accent font-extrabold text-bg"
    style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.36)}px;`}
    aria-label={name}
    role="img"
  >
    {initials}
  </div>
)}
