---
interface Props {
  label: string;
  mono?: boolean;
}

const { label, mono = false } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center rounded-full border border-border bg-surface px-3 py-1 text-xs transition-colors hover:border-accent/50',
    mono ? 'font-mono font-medium text-ink' : 'font-sans text-muted',
  ]}
>
  {label}
</span>
