---
import SectionHeading from './SectionHeading.astro';
import { competitions } from '../data/competitions';

const featured = competitions.find((c) => c.featured);
const rest = competitions.filter((c) => !c.featured);

function splitMetric(metric: string) {
  const match = metric.match(/^([\d.]+)(.*)$/);
  if (!match) return null;
  const [, value, suffix] = match;
  const decimals = value.includes('.') ? value.split('.')[1].length : 0;
  return { value, suffix, decimals };
}
---

<section id="competitions">
  <SectionHeading title="Competitions & Awards" />
  {featured && (
    <article data-animate class="rounded-xl bg-ink p-7 text-bg">
      <div class="flex flex-wrap justify-between gap-x-8 gap-y-5">
        <div class="min-w-0 flex-[1_1_320px]">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-[#9DB4FF]">
            {featured.result} · {featured.period}
          </p>
          <h3 class="mt-2 text-lg font-bold tracking-tight">{featured.event}</h3>
          <p class="mt-1 text-xs text-[#8E919B]">{featured.location}</p>
          {featured.bullets.map((bullet) => (
            <p class="mt-3 text-[13px] leading-relaxed text-[#B9BCC6]">{bullet}</p>
          ))}
        </div>
        {featured.highlights && (
          <div class="flex shrink-0 gap-8">
            {featured.highlights.map((highlight) => {
              const parts = splitMetric(highlight.value);
              return (
                <div>
                  {parts ? (
                    <div
                      data-count-to={parts.value}
                      data-count-suffix={parts.suffix}
                      data-count-decimals={parts.decimals}
                      class="font-mono text-xl font-semibold leading-none"
                    >
                      {highlight.value}
                    </div>
                  ) : (
                    <div class="font-mono text-xl font-semibold leading-none">{highlight.value}</div>
                  )}
                  <div class="mt-1.5 max-w-[140px] text-[10.5px] font-semibold uppercase tracking-wide leading-snug text-[#8E919B]">
                    {highlight.label}
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>
    </article>
  )}
  <div class="mt-2">
    {rest.map((c, index) => (
      <div
        data-animate
        style={`--reveal-delay: ${Math.min(index * 0.08, 0.4)}s`}
        class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-border px-0.5 py-4"
      >
        <div class="min-w-0 flex-[1_1_280px]">
          <h3 class="text-sm font-semibold text-ink">{c.event}</h3>
          <p class="mt-0.5 text-xs text-muted">
            {c.location} · {c.period}{c.context ? ` · ${c.context}` : ''}
          </p>
        </div>
        <p class="font-mono text-xs font-semibold text-accent">{c.result}</p>
      </div>
    ))}
  </div>
</section>
