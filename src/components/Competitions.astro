---
import SectionHeading from './SectionHeading.astro';
import { competitions } from '../data/competitions';
---

<section id="competitions" data-animate>
  <SectionHeading title="Competitions & Awards" />
  <div class="space-y-5">
    {competitions.map((c) => (
      <article class="rounded-lg border border-border bg-surface p-5">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <h3 class="text-sm font-bold leading-snug text-ink">{c.event}</h3>
            <p class="mt-1 text-xs text-muted">{c.location}</p>
          </div>
          <span class="inline-flex items-center rounded-full border border-accent/30 bg-accent/5 px-3 py-1 font-mono text-xs font-semibold text-accent">
            {c.result}
          </span>
        </div>
        <p class="mt-2 font-mono text-[11px] text-muted">{c.period}</p>
        <ul class="mt-3 space-y-1.5">
          {c.bullets.map((bullet) => (
            <li class="flex gap-2 text-xs leading-relaxed text-muted">
              <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-accent"></span>
              <span>{bullet}</span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>
