---
import SectionHeading from './SectionHeading.astro';
import { news } from '../data/news';
---

<section id="news">
  <SectionHeading title="News" />
  <ul class="space-y-3">
    {news.map((item, index) => (
      <li
        data-animate
        style={`--reveal-delay: ${Math.min(index * 0.06, 0.3)}s`}
        class="flex gap-4"
      >
        <span class="w-20 shrink-0 pt-0.5 font-mono text-[11px] font-medium text-accent">
          {item.date}
        </span>
        {item.link ? (
          <a
            href={item.link}
            target="_blank"
            rel="noreferrer"
            class="text-sm leading-relaxed text-muted transition-colors hover:text-accent"
          >
            {item.text} <span aria-hidden="true">&#8599;</span>
          </a>
        ) : (
          <span class="text-sm leading-relaxed text-muted">{item.text}</span>
        )}
      </li>
    ))}
  </ul>
</section>
