---
import SectionHeading from './SectionHeading.astro';
import Tag from './Tag.astro';
import { research } from '../data/research';

function splitMetric(metric: string) {
  const match = metric.match(/^([\d.]+)(.*)$/);
  if (!match) return { value: '0', suffix: metric, decimals: 0 };
  const [, value, suffix] = match;
  const decimals = value.includes('.') ? value.split('.')[1].length : 0;
  return { value, suffix, decimals };
}
---

<section id="research" data-animate>
  <SectionHeading title="Research Projects" />
  <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
    {research.map((project) => (
      <article
        tabindex="0"
        class="group rounded-lg border border-border bg-surface p-5 outline-none transition-all duration-200 ease-out hover:-translate-y-1 hover:border-accent/40 hover:shadow-lg hover:shadow-accent/5 focus-visible:-translate-y-1 focus-visible:border-accent/40 focus-visible:shadow-lg focus-visible:shadow-accent/5"
      >
        <div class="flex items-start justify-between gap-3">
          <h3 class="text-sm font-bold leading-snug text-ink">{project.title}</h3>
          {project.metric && (() => {
            const { value, suffix, decimals } = splitMetric(project.metric);
            return (
              <span
                data-count-to={value}
                data-count-suffix={suffix}
                data-count-decimals={decimals}
                class="shrink-0 rounded-full border border-accent/30 bg-accent/5 px-2.5 py-1 font-mono text-xs font-semibold text-accent"
              >
                {decimals > 0 ? `0.${'0'.repeat(decimals)}` : '0'}{suffix}
              </span>
            );
          })()}
        </div>
        <p class="mt-1 text-xs text-muted">{project.org}</p>
        <p class="mt-0.5 font-mono text-[11px] text-muted">{project.period}</p>
        <p class="mt-3 text-sm leading-relaxed text-muted">{project.description}</p>
        <ul class="mt-3 max-h-0 space-y-1.5 overflow-hidden opacity-0 transition-all duration-300 ease-out group-hover:max-h-96 group-hover:opacity-100 group-focus-within:max-h-96 group-focus-within:opacity-100">
          {project.bullets.map((bullet) => (
            <li class="flex gap-2 text-xs leading-relaxed text-muted">
              <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-accent"></span>
              <span>{bullet}</span>
            </li>
          ))}
        </ul>
        <div class="mt-4 flex flex-wrap gap-2">
          {project.tags.map((tag) => <Tag label={tag} />)}
        </div>
      </article>
    ))}
  </div>
</section>
