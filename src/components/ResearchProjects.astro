---
import SectionHeading from './SectionHeading.astro';
import { research } from '../data/research';

function splitMetric(metric: string) {
  const match = metric.match(/^([\d.]+)(.*)$/);
  if (!match) return { value: '0', suffix: metric, decimals: 0 };
  const [, value, suffix] = match;
  const decimals = value.includes('.') ? value.split('.')[1].length : 0;
  return { value, suffix, decimals };
}
---

<section id="research">
  <SectionHeading title="Research Projects" />
  <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
    {research.map((project, index) => (
      <article
        data-animate
        style={`--reveal-delay: ${Math.min(index * 0.08, 0.4)}s`}
        class="flex flex-col rounded-lg border border-border bg-surface p-5 transition-all duration-200 ease-out hover:-translate-y-1 hover:border-accent/40 hover:shadow-lg hover:shadow-accent/5"
      >
        <div class="flex items-start justify-between gap-4">
          <h3 class="text-[15px] font-bold leading-snug text-ink">{project.title}</h3>
          {project.metric && (() => {
            const { value, suffix, decimals } = splitMetric(project.metric);
            return (
              <span
                data-count-to={value}
                data-count-suffix={suffix}
                data-count-decimals={decimals}
                class="shrink-0 font-mono text-[22px] font-semibold tracking-tight text-ink"
              >
                {decimals > 0 ? `0.${'0'.repeat(decimals)}` : '0'}{suffix}
              </span>
            );
          })()}
        </div>
        <p class="mt-2 text-xs text-muted">{project.org}</p>
        <p class="mt-0.5 font-mono text-[11px] text-muted">{project.period}</p>
        <p class="mt-3 text-[13.5px] leading-relaxed text-body">{project.description}</p>
        <ul class="mt-3 space-y-1.5">
          {project.bullets.map((bullet) => (
            <li class="flex gap-2 text-xs leading-relaxed text-muted">
              <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-[#C6C8CF]"></span>
              <span>{bullet}</span>
            </li>
          ))}
        </ul>
        <p class="mt-auto pt-4">
          <span class="block border-t border-border/60 pt-3.5 font-mono text-[11px] text-muted">
            {project.tags.join(' · ')}
          </span>
        </p>
      </article>
    ))}
  </div>
</section>
