---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jui-Chien Tsou',
  alternateName: 'Eric Tsou',
  url: Astro.site?.toString(),
  image: new URL('/avatar.jpeg', Astro.site).toString(),
  email: 'mailto:tsouoeric@gmail.com',
  jobTitle: 'Undergraduate Researcher',
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'National Taiwan University',
  },
  sameAs: [
    'https://github.com/pango0',
    'https://www.linkedin.com/in/jui-chien-tsou-bb5b86317/',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAFAF9" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline>
      document.documentElement.classList.add('js-anim');
    </script>
  </head>
  <body class="bg-bg text-ink antialiased">
    <div class="sticky top-0 z-30 h-[3px] w-full bg-border/60">
      <div id="scroll-progress" class="h-full w-0 bg-accent"></div>
    </div>
    <div class="mx-auto max-w-6xl px-6 py-12 lg:py-16">
      <div class="flex flex-col gap-12 lg:flex-row lg:gap-16">
        <Sidebar />
        <main class="min-w-0 flex-1 space-y-16">
          <slot />
        </main>
      </div>
      <Footer />
    </div>
    <script is:inline>
      (function () {
        var targets = document.querySelectorAll('[data-animate]');
        if (!('IntersectionObserver' in window) || !targets.length) return;
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        targets.forEach(function (el) {
          observer.observe(el);
        });
      })();
    </script>
    <script is:inline>
      (function () {
        var links = document.querySelectorAll('[data-nav-link]');
        if (!links.length || !('IntersectionObserver' in window)) return;
        var marker = document.getElementById('nav-marker');
        var byId = {};
        links.forEach(function (link) {
          byId[link.getAttribute('href').slice(1)] = link;
        });
        var current = null;
        function moveMarker() {
          if (!marker || !current) return;
          marker.style.opacity = '1';
          marker.style.transform =
            'translateY(' + (current.offsetTop + (current.offsetHeight - 14) / 2) + 'px)';
        }
        var navObserver = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting && byId[entry.target.id]) {
                if (current) {
                  current.classList.remove('is-active');
                  current.removeAttribute('aria-current');
                }
                current = byId[entry.target.id];
                current.classList.add('is-active');
                current.setAttribute('aria-current', 'true');
                moveMarker();
              }
            });
          },
          { rootMargin: '-15% 0px -70% 0px' }
        );
        Object.keys(byId).forEach(function (id) {
          var section = document.getElementById(id);
          if (section) navObserver.observe(section);
        });
        window.addEventListener('resize', moveMarker);
      })();
    </script>
    <script is:inline>
      (function () {
        var bar = document.getElementById('scroll-progress');
        if (!bar) return;
        function update() {
          var scrollTop = window.scrollY || document.documentElement.scrollTop;
          var height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          var pct = height > 0 ? (scrollTop / height) * 100 : 0;
          bar.style.width = pct + '%';
        }
        update();
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
      })();
    </script>
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('[data-count-to]');
        if (!els.length) return;
        var reduceMotion =
          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion) return; // server-rendered text already shows the final value

        function finalText(el) {
          var target = parseFloat(el.getAttribute('data-count-to'));
          var suffix = el.getAttribute('data-count-suffix') || '';
          var decimals = parseInt(el.getAttribute('data-count-decimals') || '0', 10);
          return target.toFixed(decimals) + suffix;
        }

        function build(el) {
          var text = finalText(el);
          var wrap = document.createElement('span');
          wrap.className = 'odo';
          wrap.setAttribute('aria-hidden', 'true');
          var cols = [];
          text.split('').forEach(function (ch) {
            if (ch >= '0' && ch <= '9') {
              var col = document.createElement('span');
              col.className = 'odo-col';
              var strip = document.createElement('span');
              strip.className = 'odo-strip';
              for (var d = 0; d <= 9; d += 1) {
                var digit = document.createElement('span');
                digit.className = 'odo-digit';
                digit.textContent = String(d);
                strip.appendChild(digit);
              }
              col.appendChild(strip);
              wrap.appendChild(col);
              cols.push({ strip: strip, digit: Number(ch) });
            } else {
              var sep = document.createElement('span');
              sep.className = 'odo-sep';
              sep.textContent = ch === ' ' ? ' ' : ch;
              wrap.appendChild(sep);
            }
          });
          el.setAttribute('aria-label', text);
          el.textContent = '';
          el.appendChild(wrap);
          return cols;
        }

        function roll(cols) {
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              cols.forEach(function (c, i) {
                c.strip.style.transitionDelay = i * 110 + 'ms';
                c.strip.style.transform = 'translateY(-' + c.digit + 'em)';
              });
            });
          });
        }

        var pending = [];
        els.forEach(function (el) {
          pending.push({ el: el, cols: build(el) });
        });

        if (!('IntersectionObserver' in window)) {
          pending.forEach(function (p) {
            roll(p.cols);
          });
          return;
        }
        var countObserver = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                pending.forEach(function (p) {
                  if (p.el === entry.target) roll(p.cols);
                });
                countObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.4 }
        );
        pending.forEach(function (p) {
          countObserver.observe(p.el);
        });
      })();
    </script>
  </body>
</html>
